# ============================================================
# Copie para .env.local e preencha. Sem estas variáveis o
# sistema roda em modo demonstração (dados locais no navegador).
# ============================================================

# --- Supabase (backend na nuvem: login, banco e arquivos) ---
# Crie um projeto em https://supabase.com e copie de Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (SOMENTE no servidor — nunca exponha no navegador).
# Necessária para o webhook de tribunais gravar andamentos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Landing page: endereço público e rastreamento do Google Ads ---
# Endereço final do site (usado no SEO e na prévia de compartilhamento).
NEXT_PUBLIC_SITE_URL=
# Rastreamento de conversões do Google Ads na landing (opcional).
# NEXT_PUBLIC_GADS_ID: o "ID de conversão" (ex.: AW-123456789).
# NEXT_PUBLIC_GADS_WHATSAPP_LABEL: o "rótulo" da conversão de clique no WhatsApp.
# NEXT_PUBLIC_GADS_CALL_LABEL: (opcional) rótulo da conversão de ligação.
# Sem o ID, o rastreamento fica desligado e não afeta o site.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=

# --- Google Agenda (feed .ics) ---
# Senha secreta que protege o link do calendário. Invente uma sequência longa.
# O link fica: https://SEU-SITE/api/calendar/feed?token=<este valor>
CALENDAR_FEED_TOKEN=

# --- DataJud / CNJ (gratuito, sem cadastro) ---
# Chave PÚBLICA da API do DataJud (a mesma para todos, publicada pelo CNJ).
# Só preencha se o CNJ trocar a chave; senão o padrão embutido já funciona.
DATAJUD_API_KEY=

# --- Monitoramento de tribunais (opcional, serviço pago) ---
# Provedores suportados: escavador | judit
TRIBUNAL_API_PROVIDER=
TRIBUNAL_API_KEY=
# Segredo que o provedor deve enviar no cabeçalho x-webhook-secret
TRIBUNAL_WEBHOOK_SECRET=
# Monitoramento por OAB (recomendado): acompanha todos os seus processos
TRIBUNAL_OAB=431515
TRIBUNAL_OAB_UF=SP
